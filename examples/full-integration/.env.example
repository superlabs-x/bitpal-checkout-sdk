# BitPal SDK full-integration example — env template
#
# 실제 값은 .env에 채우고 .gitignore에 등록한다 (이 .example 파일은 커밋 OK).

# BitPal 콘솔 → Developers → API Keys에서 발급. test/live 환경별 prefix:
#   bp_test_xxx — TEST 환경 (가짜 결제, sim_xxx tx hash)
#   bp_live_xxx — LIVE 환경 (실 USDC, 실 on-chain tx)
BITPAL_API_KEY=

# BitPal API base URL.
# - 로컬 개발: http://localhost:3100
# - Production: https://api.bitpal.io
BITPAL_API_BASE=http://localhost:3100

# Webhook endpoint 등록 시 1회 노출되는 secret (whsec_xxx). 분실 시 재생성 필요.
BITPAL_WEBHOOK_SECRET=

# 머천트 backend 자기 포트 (Express webhook receiver)
PORT=4000

# 머천트 success/cancel 페이지 (buyer가 결제 완료/취소 후 redirect됨)
MERCHANT_SUCCESS_URL=http://localhost:4000/order-complete
MERCHANT_CANCEL_URL=http://localhost:4000/cart
